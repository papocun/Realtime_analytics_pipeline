# Snowflake Connection Settings (Server-side only - NEVER prefix with NEXT_PUBLIC_)
SNOWFLAKE_ACCOUNT=xy12345.ap-southeast-1.aws
SNOWFLAKE_USER=analytics_service_user
SNOWFLAKE_DATABASE=SPOTIFY_DB
SNOWFLAKE_SCHEMA=GOLD
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ANALYTICS_RO
# Path to RSA private key file (.p8) for Key-Pair Authentication
SNOWFLAKE_PRIVATE_KEY_PATH=secrets/rsa_key.p8
