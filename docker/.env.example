# =============================================================================
# Docker Services — Environment Configuration
# =============================================================================
# Copy this file to docker/.env and fill in values for your local environment.
# Never commit the actual .env file to source control.
# =============================================================================

# ---------- MinIO Configuration ----------
MINIO_ROOT_USER=your_minio_root_user
MINIO_ROOT_PASSWORD=your_minio_root_password

# ---------- PostgreSQL Configuration (Airflow metadata database) ----------
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=airflow

# ---------- Airflow Admin User ----------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_PASSWORD=your_airflow_admin_password
