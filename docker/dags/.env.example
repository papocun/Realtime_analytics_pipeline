# Airflow DAG (MinIO -> Snowflake Bronze). Copy to docker/dags/.env
MINIO_ENDPOINT=http://minio:9000
MINIO_HOST_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=spotify
MINIO_PREFIX=bronze/date=
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PRIVATE_KEY_PATH=/opt/airflow/secrets/rsa_key.p8
SNOWFLAKE_ACCOUNT=your_account.your_region.aws
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SPOTIFY_DB
SNOWFLAKE_SCHEMA=BRONZE
SNOWFLAKE_TABLE=SPOTIFY_EVENTS_BRONZE
LOCAL_TEMP_PATH=/tmp/spotify_raw.json
