# =============================================================================
# Airflow DAG — Environment Configuration (docker/dags/.env)
# =============================================================================
# Copy this file to docker/dags/.env and fill in your environment values.
# Never commit the actual .env file to source control.
# The DAG container reads this file at /opt/airflow/dags/.env.
# =============================================================================

# ---------- MinIO Configuration ----------
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=spotify
MINIO_PREFIX=bronze/date=

# ---------- Snowflake Configuration ----------
# Account identifier format: <locator>.<region>.<cloud>
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PRIVATE_KEY_PATH=/opt/airflow/secrets/rsa_key.p8
SNOWFLAKE_ACCOUNT=your_account.your_region.aws
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SPOTIFY_DB
SNOWFLAKE_SCHEMA=BRONZE
SNOWFLAKE_TABLE=SPOTIFY_EVENTS_BRONZE

# ---------- Local Temp Path (inside container) ----------
LOCAL_TEMP_PATH=/tmp/spotify_raw.json
