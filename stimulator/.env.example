# Event producer. Copy to stimulator/.env. PRODUCER_MODE: live | historical | replay
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=spotify-events
PRODUCER_MODE=live
USER_COUNT=20
SONG_COUNT=6
ARTIST_COUNT=6
# RANDOM_SEED      – integer seed for reproducible event generation;
BACKFILL_EVENTS=1000
HISTORICAL_DAYS=30
BATCH_SIZE=50
# RANDOM_SEED=42
EVENT_INTERVAL_SECONDS=1
REPLAY_COUNT=20
