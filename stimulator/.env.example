# =============================================================================
# Spotify Synthetic Event Producer — Environment Configuration
# =============================================================================
# Copy this file to stimulator/.env and fill in values appropriate for your
# local environment. Never commit the actual .env file to source control.
# =============================================================================

# ---------------------------------------------------------------------------
# Kafka Connection
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=spotify-events

# ---------------------------------------------------------------------------
# Producer Mode
# ---------------------------------------------------------------------------
# Controls which operating mode the producer runs in.
# Allowed values: live | historical | replay
#
#   live       – Continuously emit new events at EVENT_INTERVAL_SECONDS.
#   historical – Generate BACKFILL_EVENTS events with past timestamps.
#   replay     – Publish REPLAY_COUNT fixture events (stable event_ids)
#                for idempotency / consumer testing.
#
PRODUCER_MODE=live

# ---------------------------------------------------------------------------
# Catalog Sizes (stable entity IDs across producer restarts)
# ---------------------------------------------------------------------------
USER_COUNT=20
SONG_COUNT=6
ARTIST_COUNT=6

# ---------------------------------------------------------------------------
# Historical Backfill Settings (used when PRODUCER_MODE=historical)
# ---------------------------------------------------------------------------
# BACKFILL_EVENTS  – total number of events to publish
# HISTORICAL_DAYS  – events distributed randomly over this many past days
# BATCH_SIZE       – how many events to buffer before flushing to Kafka
# RANDOM_SEED      – integer seed for reproducible event generation;
#                    leave unset for non-deterministic output
#
BACKFILL_EVENTS=1000
HISTORICAL_DAYS=30
BATCH_SIZE=50
# RANDOM_SEED=42

# ---------------------------------------------------------------------------
# Live Mode Settings (used when PRODUCER_MODE=live)
# ---------------------------------------------------------------------------
# Delay in seconds between emitting events. Use 0 for maximum throughput.
EVENT_INTERVAL_SECONDS=1

# ---------------------------------------------------------------------------
# Replay/Test Mode Settings (used when PRODUCER_MODE=replay)
# ---------------------------------------------------------------------------
# Number of fixture events to replay. Event IDs are stable (seed=42).
REPLAY_COUNT=20
